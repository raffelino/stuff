<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- Kopfzeile: aktueller Spieler + Audio-Schalter -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_panel_translucent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="12dp"
        android:paddingRight="6dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/textTurn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="Spieler 1 ist dran"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnMusic"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@android:color/transparent"
            android:minWidth="0dp"
            android:text="🎵"
            android:textSize="20sp" />

        <Button
            android:id="@+id/btnSfx"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@android:color/transparent"
            android:minWidth="0dp"
            android:text="🔊"
            android:textSize="20sp" />
    </LinearLayout>

    <!-- Spielbrett -->
    <com.raffelino.rechenwuerfel.BoardView
        android:id="@+id/boardView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:padding="4dp" />

    <!-- Unterer Bereich: wechselt zwischen Würfeln / Joker / Aufgabe / Meldung / Sieg -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_panel"
        android:padding="10dp">

        <!-- Würfeln -->
        <LinearLayout
            android:id="@+id/panelRoll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <com.raffelino.rechenwuerfel.DiceView
                android:id="@+id/diceView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/textDiceHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tap_to_roll"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btnRoll"
                style="@style/ButtonPrimary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/roll" />

            <TextView
                android:id="@+id/textStepsHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#78909C"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Joker: Rechenart wählen -->
        <LinearLayout
            android:id="@+id/panelJoker"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="@string/joker_title"
                android:textSize="20sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <Button android:id="@+id/btnJokerPlus" style="@style/Key" android:layout_height="72dp" android:text="+" android:textColor="#2E7D32" android:textSize="32sp" />
                <Button android:id="@+id/btnJokerMinus" style="@style/Key" android:layout_height="72dp" android:text="−" android:textColor="#C62828" android:textSize="32sp" />
                <Button android:id="@+id/btnJokerTimes" style="@style/Key" android:layout_height="72dp" android:text="×" android:textColor="#1565C0" android:textSize="32sp" />
                <Button android:id="@+id/btnJokerDivide" style="@style/Key" android:layout_height="72dp" android:text="÷" android:textColor="#6A1B9A" android:textSize="32sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Rechenaufgabe -->
        <LinearLayout
            android:id="@+id/panelTask"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ProgressBar
                    android:id="@+id/progressTime"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="14dp"
                    android:layout_weight="1"
                    android:max="1000"
                    android:progress="1000"
                    android:progressDrawable="@drawable/progress_timer" />

                <TextView
                    android:id="@+id/textTimeLeft"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:minWidth="44dp"
                    android:gravity="right"
                    android:text="30 s"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textQuestion"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="right"
                    android:text="23 + 45 = ?"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textAnswer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="12dp"
                    android:background="@drawable/bg_input"
                    android:minWidth="90dp"
                    android:gravity="center"
                    android:text="_"
                    android:textColor="@color/primary"
                    android:textSize="30sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/textTaskInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:textColor="#78909C"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="4dp"
                android:orientation="vertical">

                <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
                    <Button android:id="@+id/key7" style="@style/Key" android:text="7" />
                    <Button android:id="@+id/key8" style="@style/Key" android:text="8" />
                    <Button android:id="@+id/key9" style="@style/Key" android:text="9" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
                    <Button android:id="@+id/key4" style="@style/Key" android:text="4" />
                    <Button android:id="@+id/key5" style="@style/Key" android:text="5" />
                    <Button android:id="@+id/key6" style="@style/Key" android:text="6" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
                    <Button android:id="@+id/key1" style="@style/Key" android:text="1" />
                    <Button android:id="@+id/key2" style="@style/Key" android:text="2" />
                    <Button android:id="@+id/key3" style="@style/Key" android:text="3" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
                    <Button android:id="@+id/keyBack" style="@style/Key" android:background="@drawable/bg_key_back" android:text="@string/key_back" />
                    <Button android:id="@+id/key0" style="@style/Key" android:text="0" />
                    <Button android:id="@+id/keyOk" style="@style/Key" android:background="@drawable/bg_key_ok" android:text="@string/key_ok" android:textColor="@color/text_light" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Meldung (richtig / falsch / Zeit / aussetzen) -->
        <LinearLayout
            android:id="@+id/panelMessage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/textMessage"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:textSize="20sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnNext"
                style="@style/ButtonPrimary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/next_player" />
        </LinearLayout>

        <!-- Sieg -->
        <LinearLayout
            android:id="@+id/panelWin"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/textWinner"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:textSize="26sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <Button android:id="@+id/btnPlayAgain" style="@style/ButtonPrimary" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginRight="4dp" android:textSize="16sp" android:text="@string/play_again" />
                <Button android:id="@+id/btnMenu" style="@style/ButtonSecondary" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginLeft="4dp" android:textSize="16sp" android:text="@string/to_menu" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
